<!-- One host only, and only pages worth landing on. /account is
     deliberately absent: it is a sign-in surface, useless as a search
     result, and listing it invites a crawler to index a page that says
     nothing about the product. It stays crawlable rather than
     disallowed, because a Disallow would also stop a crawler seeing the
     noindex it would need to honour.

     The apex serves the app itself since 2026-09-09 — one document with
     the downloader below the headline and the marketing copy under it —
     so "/" covers both, and app.opendownloader.app redirects here. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://opendownloader.app/</loc>
    <lastmod>2026-09-09</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://opendownloader.app/privacy.html</loc>
    <lastmod>2026-09-06</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
