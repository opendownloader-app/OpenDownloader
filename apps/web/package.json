{
  "name": "@opendownloader/web",
  "version": "0.2.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm -w @opendownloader/engine && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build:e2e && node e2e/smoke.mjs",
    "build:e2e": "OPENDOWNLOADER_E2E=1 npm run build"
  },
  "dependencies": {
    "@opendownloader/engine": "*",
    "@opendownloader/ui": "*",
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
