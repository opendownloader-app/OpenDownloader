{
  "name": "@opendownloader/extension",
  "version": "0.2.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "build:wasm": "npm run build:wasm -w @opendownloader/engine",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:wasm && vite build && node scripts/copy-static.mjs",
    "build:firefox": "npm run build:wasm && TARGET_BROWSER=firefox vite build && TARGET_BROWSER=firefox node scripts/copy-static.mjs",
    "build:all": "npm run build && npm run build:firefox",
    "typecheck": "tsc --noEmit",
    "build:e2e": "OPENDOWNLOADER_E2E=1 npm run build",
    "e2e": "npm run build:e2e && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "@opendownloader/engine": "*",
    "@opendownloader/ui": "*"
  }
}
